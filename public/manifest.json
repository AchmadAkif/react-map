{
  "name": "React-Map",
  "version": "1.0.0",
  "manifest_version": 3,
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_script.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["installHook.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "permissions": ["tabs", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
