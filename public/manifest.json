{
  "manifest_version": 3,
  "version": "1.0.0",
  "name": "My Extension",
  "devtools_page": "src/extension/devtools.html",
  "background": {
    "service_worker": "src/extension/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/extension/content_script.js"]
    }
  ],
  "permissions": ["scripting"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
